---
import Layout from "../layouts/layout.astro";

const base = `${import.meta.env.BASE_URL}/`;
---

<Layout
  title="Dr.-Ing. Rubi Debnath | Computer Scientist"
  description="Dr.-Ing. Rubi Debnath is a Computer Scientist and Postdoctoral Researcher at the Technical University of Munich, working on AI/ML-based network management, agentic networking, and deterministic networking."
>

 <!-- HERO -->
<section class="hero">
  <div class="container hero-grid">

    <div class="hero-content">

      <p class="eyebrow">
        COMPUTER SCIENTIST · POSTDOCTORAL RESEARCHER
      </p>

      <h1>
        Intelligent systems<br />
        for <span>future networks.</span>
      </h1>

      <p class="intro">
		I am <strong>Dr.-Ing. Rubi Debnath</strong>, a Computer Scientist and
		Postdoctoral Researcher at the Technical University of Munich (TUM),
		specializing in AI/ML-driven network management and orchestration.
	  </p>

      <p class="intro">
		My research explores the intersection of
		<strong>AI/ML, network management, and orchestration</strong>,
		with a focus on intelligent and agentic approaches for
		<strong> next-generation wired and wireless deterministic networks</strong>.
		My work spans <strong>Time-Sensitive Networking (TSN)</strong>,
		<strong> 5G-TSN and 6G-TSN integration</strong>, and
		<strong> agentic network management</strong> for
		<strong> safety-critical applications</strong>.
	 </p>

      <div class="research-tags">
        <span>AI / ML</span>
        <span>Agentic Networking</span>
        <span>Deterministic Networking</span>
        <span>TSN</span>
      </div>

      <div class="actions">

        <a
          class="button button-primary"
          href={`${base}research/`}
        >
          Explore my research
          <span>→</span>
        </a>

        <a
          class="button button-secondary"
          href={`${base}publications/`}
        >
          Publications
        </a>

      </div>

      <div class="profile-links">

        <a href="mailto:rubi.debnath@tum.de">
          Email
        </a>

        <a href="https://scholar.google.com/citations?user=1VWxOm0AAAAJ&hl=en">
          Google Scholar
        </a>

        <a href="https://orcid.org/0000-0001-7150-4669">
          ORCID
        </a>

        <!--<a href="YOUR_GITHUB_URL">
          GitHub
        </a>-->

      </div>

    </div>


    <div class="photo-column">

      <div class="photo-frame">

        <img
          src={`${base}profile.jpg`}
          alt="Dr.-Ing. Rubi Debnath"
        />

      </div>

      <p class="photo-caption">
        TUM · Munich, Germany
      </p>

    </div>

  </div>
</section>


<!-- RESEARCH -->
<section class="research-section">

  <div class="container">

    <div class="section-header">

      <div>
        <p class="eyebrow">
          RESEARCH
        </p>

        <h2>
          Intelligent networking<br />
          <span>for deterministic systems.</span>
        </h2>
      </div>

      <a
        class="section-link"
        href={`${base}research/`}
      >
        View all research <span>→</span>
      </a>

    </div>


    <div class="research-grid">

      <article class="research-card">

        <div class="card-top">
          <span class="card-number">01</span>
          <span class="card-arrow">↗</span>
        </div>

        <div class="card-content">

          <p class="card-category">
            ARTIFICIAL INTELLIGENCE
          </p>

          <h3>
            AI & ML for Networks
          </h3>

          <p>
            Learning-based approaches for intelligent network
            management, optimization, resource allocation,
            and orchestration.
          </p>

        </div>

      </article>


      <article class="research-card">

        <div class="card-top">
          <span class="card-number">02</span>
          <span class="card-arrow">↗</span>
        </div>

        <div class="card-content">

          <p class="card-category">
            AUTONOMOUS NETWORKING
          </p>

          <h3>
            Agentic Network Management
          </h3>

          <p>
            Agentic AI systems for autonomous reasoning,
            decision-making, coordination, and closed-loop
            network operation.
          </p>

        </div>

      </article>


      <article class="research-card">

        <div class="card-top">
          <span class="card-number">03</span>
          <span class="card-arrow">↗</span>
        </div>

        <div class="card-content">

          <p class="card-category">
            DETERMINISTIC SYSTEMS
          </p>

          <h3>
            Wired, Wireless & TSN
          </h3>

          <p>
            Intelligent management of deterministic wired and
            wireless networks, with a focus on
            Time-Sensitive Networking.
          </p>

        </div>

      </article>

    </div>

  </div>

</section>


  <!-- QUICK LINKS -->

 <!-- QUICK LINKS -->
<section class="links-section">

  <div class="container">

    <div class="links-intro">
      <p class="eyebrow">
        EXPLORE
      </p>
    </div>

    <div class="links-list">

      <a
        class="link-card"
        href={`${base}publications/`}
      >
        <div class="link-number">
          01
        </div>

        <div class="link-main">
          <p class="card-label">
            PUBLICATIONS
          </p>

          <h3>
            Research papers & contributions
          </h3>

          <p>
            Peer-reviewed publications, conference papers,
            and technical contributions.
          </p>
        </div>

        <div class="link-arrow">
          →
        </div>
      </a>


       <!--<a
        class="link-card"
        href={`${base}cv/`}
      >
        <div class="link-number">
          02
        </div>

        <div class="link-main">
          <p class="card-label">
            CURRICULUM VITAE
          </p>

          <h3>
            Experience & education
          </h3>

          <p>
            Academic background, research experience,
            projects, and professional activities.
          </p>
        </div>

        <div class="link-arrow">
          →
        </div>
      </a>-->


      <a
        class="link-card"
        href={`${base}contact/`}
      >
        <div class="link-number">
          03
        </div>

        <div class="link-main">
          <p class="card-label">
            CONTACT
          </p>

          <h3>
            Let's connect
          </h3>

          <p>
            Research collaborations, discussions,
            and professional inquiries.
          </p>
        </div>

        <div class="link-arrow">
          →
        </div>
      </a>

    </div>

  </div>

</section>

</Layout>


<style>

 /* --------------------------------
   HERO
-------------------------------- */

.hero {
  padding: 92px 0 105px;
}


.container {
  width: min(calc(100% - 48px), 1080px);
  margin: 0 auto;
}


.hero-grid {
  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    360px;

  gap: 90px;

  align-items: center;
}

.hero-content {
  max-width: 700px;
}


.eyebrow {
  margin: 0 0 25px;

  color: #8993a1;

  font-size: 0.68rem;

  font-weight: 600;

  letter-spacing: 0.16em;

  line-height: 1.4;

  text-transform: uppercase;
}


h1 {
  margin: 0;

  color: #11151c;

  font-size: clamp(4rem, 6vw, 5.6rem);

  font-weight: 600;

  line-height: 0.98;

  letter-spacing: -0.06em;
}


h1 span {
  color: #7d8795;
}


.intro {
  max-width: 650px;

  margin: 30px 0 0;

  color: #657080;

  font-size: 1rem;

  line-height: 1.8;
}


.intro strong {
  color: #202631;

  font-weight: 600;
}


/* --------------------------------
   RESEARCH TAGS
-------------------------------- */

.research-tags {
  display: flex;

  flex-wrap: wrap;

  gap: 8px;

  margin-top: 27px;
}


.research-tags span {
  padding: 7px 11px;

  border: 1px solid #e1e6ec;

  border-radius: 999px;

  background: rgba(255, 255, 255, 0.65);

  color: #667181;

  font-size: 0.72rem;

  font-weight: 500;
}


/* --------------------------------
   PHOTO
-------------------------------- */

.photo-column {
  text-align: center;
}


.photo-frame {
  width: 100%;

  aspect-ratio: 4 / 5;

  overflow: hidden;

  border: 1px solid #e0e5eb;

  border-radius: 24px;

  background: #f4f5f7;

  box-shadow:
    0 24px 55px
    rgba(30, 45, 65, 0.10);
}


.photo-frame img {
  width: 100%;

  height: 100%;

  display: block;

  object-fit: cover;
}


.photo-caption {
  margin: 14px 0 0;

  color: #929ba7;

  font-size: 0.72rem;
}

  /* --------------------------------
     BUTTONS
  -------------------------------- */

  .actions {
    display: flex;

    flex-wrap: wrap;

    gap: 13px;

    margin-top: 35px;
  }


  .button {
    min-height: 47px;

    padding: 0 19px;

    display: inline-flex;

    align-items: center;

    justify-content: center;

    border-radius: 12px;

    font-size: 0.88rem;

    font-weight: 600;

    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }


  .button:hover {
    transform: translateY(-1px);
  }


  .button-primary {
    color: white;

    background: #1677f5;

    box-shadow:
      0 8px 22px
      rgba(22, 119, 245, 0.18);
  }


  .button-primary span {
    margin-left: 13px;

    font-size: 1rem;
  }


  .button-secondary {
    border: 1px solid #dce1e8;

    color: #313945;

    background: rgba(255,255,255,0.75);
  }


  /* --------------------------------
     PROFILE LINKS
  -------------------------------- */

  .profile-links {
    display: flex;

    flex-wrap: wrap;

    gap: 24px;

    margin-top: 30px;
  }


  .profile-links a {
    color: #697484;

    font-size: 0.82rem;

    transition: color 0.2s ease;
  }


  .profile-links a:hover {
    color: #1677f5;
  }


  /* --------------------------------
     PHOTO
  -------------------------------- */

  .photo-column {
    text-align: center;
  }


  .photo-frame {
    width: 100%;

    aspect-ratio: 4 / 5;

    overflow: hidden;

    border-radius: 24px;

    border: 1px solid #e0e5eb;

    background:
      linear-gradient(
        145deg,
        #edf1f5,
        #f9fafb
      );

    box-shadow:
      0 25px 60px
      rgba(30, 45, 65, 0.10);
  }


  .photo-frame img {
    width: 100%;

    height: 100%;

    display: block;

    object-fit: cover;
  }


  .photo-caption {
    margin: 17px 0 0;

    color: #8a94a2;

    font-size: 0.76rem;

    letter-spacing: 0.01em;
  }


  /* --------------------------------
   RESEARCH
-------------------------------- */

.research-section {
  padding: 105px 0 110px;

  border-top: 1px solid #e7eaf0;
}


.section-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;

  gap: 40px;

  margin-bottom: 48px;
}


.section-header h2 {
  margin: 0;

  color: #11151c;

  font-size: clamp(2.7rem, 4.2vw, 4rem);

  font-weight: 600;

  line-height: 1.04;

  letter-spacing: -0.055em;
}


.section-header h2 span {
  color: #8993a1;
}

.section-link {
  display: inline-flex;
  align-items: center;

  flex-shrink: 0;

  margin-bottom: 5px;

  color: #687384;

  font-size: 0.78rem;

  font-weight: 500;

  transition:
    color 0.2s ease;
}


.section-link span {
  margin-left: 8px;

  transition:
    transform 0.2s ease;
}


.section-link:hover {
  color: #1677ff;
}


.section-link:hover span {
  transform: translateX(3px);
}


/* --------------------------------
   RESEARCH CARDS
-------------------------------- */

.research-grid {
  display: grid;

  grid-template-columns:
    repeat(3, 1fr);

  gap: 14px;
}


.research-card {
  min-height: 280px;

  padding: 28px;

  display: flex;
  flex-direction: column;
  justify-content: space-between;

  border: 1px solid #e1e6ed;

  border-radius: 18px;

  background: #ffffff;

  transition:
    transform 0.25s ease,
    border-color 0.25s ease,
    box-shadow 0.25s ease;
}


.research-card:hover {
  transform: translateY(-3px);

  border-color: #d6dce4;

  box-shadow:
    0 16px 40px
    rgba(30, 45, 65, 0.07);
}


.card-top {
  display: flex;

  align-items: center;

  justify-content: space-between;
}


.card-number {
  color: #9aa3af;

  font-size: 0.68rem;

  font-weight: 600;

  letter-spacing: 0.04em;
}


.card-arrow {
  color: #b0b7c1;

  font-size: 0.9rem;

  transition:
    transform 0.25s ease,
    color 0.25s ease;
}


.research-card:hover .card-arrow {
  color: #1677ff;

  transform:
    translate(2px, -2px);
}


.card-content {
  max-width: 330px;
}


.card-category {
  margin: 0 0 12px;

  color: #8c96a3;

  font-size: 0.62rem;

  font-weight: 600;

  letter-spacing: 0.13em;
}


.research-card h3 {
  margin: 0 0 12px;

  color: #202630;

  font-size: 1.05rem;

  font-weight: 600;

  letter-spacing: -0.02em;
}


.research-card p {
  margin: 0;

  color: #737d8b;

  font-size: 0.8rem;

  line-height: 1.7;
}


/* --------------------------------
   QUICK LINKS
-------------------------------- */

.links-section {
  padding: 0 0 110px;
}


.links-intro {
  padding-bottom: 20px;
}


.links-list {
  grid-template-columns: 1fr;
}

.link-card {
  min-height: 190px;

  border-left: 1px solid #e1e6ed;
}

.link-card:not(:last-child) {
  border-bottom: 0;
}


.link-card:hover {
  padding-left: 12px;
  padding-right: 12px;
}


.link-number {
  color: #a0a8b3;

  font-size: 0.68rem;

  font-weight: 600;

  letter-spacing: 0.04em;
}


.link-main {
  min-width: 0;
}

.link-main .card-label {
  margin: 0 0 8px;

  color: #8c96a3;

  font-size: 0.62rem;

  font-weight: 600;

  letter-spacing: 0.13em;
}

.link-card h3 {
  margin: 0 0 7px;

  color: #202630;

  font-size: 1rem;

  font-weight: 600;

  letter-spacing: -0.015em;
}

.link-card p {
  max-width: 300px;

  margin: 0;

  color: #747e8c;

  font-size: 0.78rem;

  line-height: 1.65;
}


.card-label {
  margin: 0 0 7px;

  color: #8c96a3;

  font-size: 0.62rem;

  font-weight: 600;

  letter-spacing: 0.13em;
}


.link-card h3 {
  margin: 0 0 5px;

  color: #202630;

  font-size: 1rem;

  font-weight: 600;

  letter-spacing: -0.015em;
}


.link-card p {
  max-width: 600px;

  margin: 0;

  color: #747e8c;

  font-size: 0.8rem;

  line-height: 1.65;
}


.link-arrow {
  align-self: flex-end;

  color: #8d97a4;

  font-size: 1rem;

  transition:
    transform 0.25s ease,
    color 0.25s ease;
}

.link-card:hover .link-arrow {
  color: #1677ff;

  transform: translateX(4px);
}


  /* --------------------------------
     MOBILE
  -------------------------------- */

  @media (max-width: 850px) {

    .hero {
      padding: 65px 0 80px;
    }


    .hero-grid {
      grid-template-columns: 1fr;

      gap: 45px;
    }


    .photo-column {
      width: min(300px, 100%);

      order: -1;

      text-align: left;
    }


    .research-grid {
		display: grid;

		grid-template-columns: repeat(3, 1fr);

		gap: 16px;
	}


    .section-header {
      align-items: flex-start;

      flex-direction: column;
    }


    .link-card {
		position: relative;

		min-height: 220px;

		padding: 28px;

		display: flex;
		flex-direction: column;
		justify-content: space-between;

		border-right: 1px solid #e1e6ed;
		border-bottom: 1px solid #e1e6ed;

		background: #ffffff;

		transition:
			background 0.25s ease,
			transform 0.25s ease;
		}

		.link-card:first-child {
		border-left: 1px solid #e1e6ed;
		}

		.link-card:hover {
		background: #fafbfc;
	}

  }


  @media (max-width: 600px) {

    h1 {
      font-size: 3.1rem;
    }


    .profile-links {
      gap: 15px 20px;
    }


    .research-card {
      min-height: auto;
    }


    .number {
      margin-bottom: 35px;
    }

  }

</style>