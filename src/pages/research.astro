---
import Layout from "../layouts/layout.astro";

const base = `${import.meta.env.BASE_URL}/`;
---

<Layout
  title="Research | Dr.-Ing. Rubi Debnath"
  description="Research by Dr.-Ing. Rubi Debnath on AI/ML-based network management, agentic networking, deterministic networking, and Time-Sensitive Networking."
>

  <main class="page">

    <!-- HEADER -->

    <section class="page-header">

      <p class="eyebrow">
        RESEARCH
      </p>

      <h1>
        Intelligent networking<br />
        <span>for deterministic systems.</span>
      </h1>

      <p class="lead">
        My research explores how artificial intelligence and
        machine learning can enable intelligent, adaptive, and
        autonomous management of next-generation wired and
        wireless networks.
      </p>

    </section>


    <!-- RESEARCH AREAS -->

    <section class="research-areas">

      <article class="research-item">

        <div class="research-number">
          01
        </div>

        <div>

          <p class="category">
            ARTIFICIAL INTELLIGENCE
          </p>

          <h2>
            AI & ML-based Network Management
          </h2>

          <p>
            Developing machine learning and AI techniques for
            network monitoring, optimization, resource allocation,
            prediction, and automated network management.
          </p>

        </div>

      </article>


      <article class="research-item">

        <div class="research-number">
          02
        </div>

        <div>

          <p class="category">
            AGENTIC NETWORKING
          </p>

          <h2>
            Agentic Network Management & Orchestration
          </h2>

          <p>
            Exploring agentic approaches in which intelligent
            systems can reason about network state, coordinate
            actions, make decisions, and operate networks through
            closed-loop management and orchestration.
          </p>

        </div>

      </article>


      <article class="research-item">

        <div class="research-number">
          03
        </div>

        <div>

          <p class="category">
            DETERMINISTIC NETWORKING
          </p>

          <h2>
            Wired & Wireless Deterministic Networks
          </h2>

          <p>
            Investigating intelligent management of deterministic
            communication systems where latency, reliability,
            synchronization, and predictable behavior are critical.
          </p>

        </div>

      </article>


      <article class="research-item">

        <div class="research-number">
          04
        </div>

        <div>

          <p class="category">
            TIME-SENSITIVE NETWORKING
          </p>

          <h2>
            Time-Sensitive Networking (TSN)
          </h2>

          <p>
            Research on AI-driven management and orchestration
            for TSN, with the goal of enabling adaptive and
            reliable deterministic network operation.
          </p>

        </div>

      </article>

    </section>


    <!-- RESEARCH VISION -->

    <section class="vision">

      <p class="eyebrow">
        RESEARCH VISION
      </p>

      <h2>
        Towards networks that can
        <span> understand, reason, and adapt.</span>
      </h2>

      <p>
        The long-term goal of my research is to bridge AI and
        communication networking, moving from manually configured
        network infrastructure toward systems capable of
        continuously observing their environment, reasoning about
        changing requirements, and autonomously adapting their
        operation.
      </p>

    </section>


    <!-- BACK -->

    <div class="back-link">

      <a href={base}>
        ← Back to home
      </a>

    </div>

  </main>

</Layout>


<style>

  .page {
    width: min(calc(100% - 48px), 1080px);

    margin: 0 auto;

    padding: 100px 0 120px;
  }


  /* HEADER */

  .page-header {
    max-width: 780px;

    padding-bottom: 90px;
  }


  .eyebrow {
    margin: 0 0 22px;

    color: #8993a1;

    font-size: 0.68rem;

    font-weight: 600;

    letter-spacing: 0.16em;

    line-height: 1.4;

    text-transform: uppercase;
  }


  .page-header h1 {
    margin: 0;

    color: #11151c;

    font-size:
      clamp(
        3rem,
        6vw,
        5.2rem
      );

    font-weight: 600;

    line-height: 1;

    letter-spacing: -0.06em;
  }


  .page-header h1 span {
    color: #8993a1;
  }


  .lead {
    max-width: 680px;

    margin: 32px 0 0;

    color: #687382;

    font-size: 1rem;

    line-height: 1.85;
  }


  /* RESEARCH AREAS */

  .research-areas {
    border-top: 1px solid #e1e6ed;
  }


  .research-item {
    display: grid;

    grid-template-columns: 90px 1fr;

    gap: 30px;

    padding: 42px 0;

    border-bottom: 1px solid #e1e6ed;
  }


  .research-number {
    padding-top: 5px;

    color: #a0a8b3;

    font-size: 0.7rem;

    font-weight: 600;
  }


  .category {
    margin: 0 0 10px;

    color: #8c96a3;

    font-size: 0.62rem;

    font-weight: 600;

    letter-spacing: 0.13em;
  }


  .research-item h2 {
    max-width: 650px;

    margin: 0 0 13px;

    color: #202630;

    font-size: 1.35rem;

    font-weight: 600;

    letter-spacing: -0.025em;
  }


  .research-item p:not(.category) {
    max-width: 680px;

    margin: 0;

    color: #737d8b;

    font-size: 0.88rem;

    line-height: 1.75;
  }


  /* VISION */

  .vision {
    max-width: 760px;

    padding: 115px 0 90px;
  }


  .vision h2 {
    margin: 0;

    color: #11151c;

    font-size:
      clamp(
        2.3rem,
        4.5vw,
        3.7rem
      );

    font-weight: 600;

    line-height: 1.08;

    letter-spacing: -0.05em;
  }


  .vision h2 span {
    color: #8993a1;
  }


  .vision > p:last-child {
    max-width: 680px;

    margin: 28px 0 0;

    color: #737d8b;

    font-size: 0.92rem;

    line-height: 1.8;
  }


  /* BACK */

  .back-link {
    padding-top: 15px;
  }


  .back-link a {
    color: #687382;

    font-size: 0.8rem;

    transition: color 0.2s ease;
  }


  .back-link a:hover {
    color: #1677ff;
  }


  /* MOBILE */

  @media (max-width: 700px) {

    .page {
      width: min(calc(100% - 32px), 1080px);

      padding: 70px 0 90px;
    }


    .page-header {
      padding-bottom: 65px;
    }


    .research-item {
      grid-template-columns: 45px 1fr;

      gap: 15px;

      padding: 32px 0;
    }


    .research-item h2 {
      font-size: 1.15rem;
    }


    .vision {
      padding: 80px 0 65px;
    }

  }

</style>