---
import Layout from "../layouts/layout.astro";

const base = `${import.meta.env.BASE_URL}/`;
---

<Layout
  title="Contact | Dr.-Ing. Rubi Debnath"
  description="Contact Dr.-Ing. Rubi Debnath, Computer Scientist and Postdoctoral Researcher at the Technical University of Munich."
>

  <section class="contact-page">

    <div class="container">

      <p class="eyebrow">
        CONTACT
      </p>

      <h1>
        Let's connect<span>.</span>
      </h1>

      <p class="intro">
        I welcome research collaborations, opportunities with industry, academic discussions, and professional inquiries.
      </p>


      <div class="contact-content">

        <div class="contact-item">

          <p class="label">
            EMAIL
          </p>

          <a
            class="email"
            href="mailto:rubi.debnath@tum.de"
          >
            rubi.debnath@tum.de
            <span>↗</span>
          </a>

        </div>

      </div>

    </div>

  </section>

</Layout>


<style>

  .contact-page {
    padding: 120px 0 150px;
  }


  .container {
    width: min(calc(100% - 48px), 1080px);
    margin: 0 auto;
  }


  /* ================================
     INTRO
  ================================= */

  .eyebrow {
    margin: 0 0 25px;

    color: #8993a1;

    font-size: 0.68rem;

    font-weight: 600;

    letter-spacing: 0.16em;

    line-height: 1.4;

    text-transform: uppercase;
  }


  h1 {
    margin: 0;

    color: #11151c;

    font-family:
      "DM Serif Display",
      Georgia,
      serif;

    font-size:
      clamp(
        4rem,
        8vw,
        6.8rem
      );

    font-weight: 400;

    line-height: 0.95;

    letter-spacing: -0.055em;
  }


  h1 span {
    color: #1677f5;
  }


  .intro {
    max-width: 560px;

    margin: 32px 0 0;

    color: #697382;

    font-size: 1rem;

    line-height: 1.8;
  }


  /* ================================
     CONTACT
  ================================= */

  .contact-content {
    max-width: 720px;

    margin-top: 70px;

    padding-top: 28px;

    border-top:
      1px solid #e5e9ef;
  }


  .contact-item {
    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 30px;
  }


  .label {
    margin: 0;

    color: #8993a1;

    font-size: 0.62rem;

    font-weight: 600;

    letter-spacing: 0.13em;
  }


  .email {
    display: inline-flex;

    align-items: center;

    gap: 12px;

    color: #202630;

    font-size: 1rem;

    font-weight: 500;

    transition:
      color 0.2s ease;
  }


  .email span {
    color: #9aa3af;

    font-size: 1rem;

    transition:
      transform 0.2s ease,
      color 0.2s ease;
  }


  .email:hover {
    color: #1677f5;
  }


  .email:hover span {
    color: #1677f5;

    transform:
      translate(3px, -3px);
  }


  /* ================================
     MOBILE
  ================================= */

  @media (max-width: 650px) {

    .contact-page {
      padding: 80px 0 110px;
    }


    .container {
      width:
        min(
          calc(100% - 32px),
          1080px
        );
    }


    h1 {
      font-size: 4rem;
    }


    .contact-content {
      margin-top: 55px;
    }


    .contact-item {
      align-items: flex-start;

      flex-direction: column;

      gap: 14px;
    }


    .email {
      font-size: 0.92rem;
    }

  }

</style>