---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Dr.-Ing. Rubi Debnath | Computer Scientist",
  description = "Personal website of Dr.-Ing. Rubi Debnath, Computer Scientist and Postdoctoral Researcher at the Technical University of Munich.",
} = Astro.props;

const base = `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />

    <title>{title}</title>
  </head>

  <body>

    <!-- ================================
         TOP NAVIGATION
    ================================= -->

    <header class="site-header">

      <div class="nav-wrap">

        <a class="brand" href={base} aria-label="Rubi Debnath home">

          <span class="brand-name">
            Rubi Debnath
          </span>

          <span class="brand-role">
            Computer Scientist
          </span>

        </a>


        <nav aria-label="Main navigation">

          <a href={`${base}research/`}>
            Research
          </a>

          <!--<a href={`${base}publications/`}>
            Publications
          </a>-->

          <!--<a href={`${base}teaching/`}>
            Teaching
          </a>-->

          <!--<a href={`${base}cv/`}>
            CV
          </a>-->

          <a href={`${base}contact/`}>
            Contact
          </a>

        </nav>

      </div>

    </header>


    <!-- ================================
         PAGE CONTENT
    ================================= -->

    <main>
      <slot />
    </main>


    <!-- ================================
         FOOTER
    ================================= -->

    <footer class="site-footer">

      <div class="footer-wrap">

        <div class="footer-identity">

          <strong>
            Dr.-Ing. Rubi Debnath
          </strong>

          <span>
            Technical University of Munich (TUM)
          </span>

        </div>


        <div class="footer-right">

          <nav class="footer-links" aria-label="Footer navigation">

            <a href={base}>
              About
            </a>

            <a href={`${base}research/`}>
              Research
            </a>

            <!--<a href={`${base}publications/`}>
              Publications
            </a>-->

            <!--<a href={`${base}teaching/`}>
              Teaching
            </a>-->

            <!--<a href={`${base}cv/`}>
              CV
            </a>-->

            <a href={`${base}contact/`}>
              Contact
            </a>

          </nav>


          <span class="copyright">
            © {new Date().getFullYear()} Dr.-Ing. Rubi Debnath
          </span>

        </div>

      </div>

    </footer>

  </body>
</html>


<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=DM+Serif+Display&display=swap");

  :root {
    --bg: #ffffff;
    --text: #111318;
    --muted: #697382;
    --subtle: #929aa6;
    --line: #e7eaf0;
    --blue: #1677f5;
    --max: 1080px;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    margin: 0;
    padding: 0;
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    padding: 0;
    background: var(--bg);
    color: var(--text);
    font-family:
      Inter,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  /* ================================
     HEADER
  ================================= */

  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;

    width: 100%;

    border-bottom: 1px solid var(--line);

    background: rgba(255, 255, 255, 0.92);

    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .nav-wrap {
    width: min(calc(100% - 48px), var(--max));
    min-height: 76px;

    margin: 0 auto;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 40px;
  }

  /* ================================
     BRAND
  ================================= */

  .brand {
    display: flex;
    flex-direction: column;

    flex-shrink: 0;

    gap: 2px;

    color: #15181e;
  }

  .brand-name {
    display: block;

    font-size: 0.96rem;
    font-weight: 600;

    letter-spacing: -0.025em;
    line-height: 1.2;
  }

  .brand-role {
    display: block;

    color: var(--subtle);

    font-size: 0.58rem;
    font-weight: 500;

    letter-spacing: 0.1em;
    line-height: 1.4;

    text-transform: uppercase;
  }

  /* ================================
     NAVIGATION
  ================================= */

  .site-header nav {
    display: flex;
    align-items: center;

    gap: 30px;
  }

  .site-header nav a {
    position: relative;

    display: inline-block;

    padding: 8px 0;

    color: #697382;

    font-size: 0.78rem;
    font-weight: 500;

    white-space: nowrap;

    transition: color 0.2s ease;
  }

  .site-header nav a::after {
    content: "";

    position: absolute;

    left: 0;
    right: 0;
    bottom: 1px;

    height: 1px;

    background: var(--blue);

    transform: scaleX(0);
    transform-origin: center;

    transition: transform 0.2s ease;
  }

  .site-header nav a:hover {
    color: #15181e;
  }

  .site-header nav a:hover::after {
    transform: scaleX(1);
  }

  /* ================================
     MAIN
  ================================= */

  main {
    min-height: calc(100vh - 160px);
  }

  /* ================================
     FOOTER
  ================================= */

  .site-footer {
    border-top: 1px solid var(--line);
    background: #fafbfc;
  }

  .footer-wrap {
    width: min(calc(100% - 48px), var(--max));

    margin: 0 auto;

    padding: 42px 0;

    display: flex;
    align-items: flex-start;
    justify-content: space-between;

    gap: 40px;
  }

  .footer-identity strong {
    display: block;

    color: #20242b;

    font-size: 0.88rem;
    font-weight: 600;
  }

  .footer-identity span {
    display: block;

    margin-top: 5px;

    color: var(--subtle);

    font-size: 0.76rem;
  }

  .footer-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;

    gap: 10px;
  }

  .footer-links {
    display: flex;
    align-items: center;

    gap: 20px;
  }

  .footer-links a {
    color: #697382;

    font-size: 0.75rem;

    transition: color 0.2s ease;
  }

  .footer-links a:hover {
    color: var(--blue);
  }

  .copyright {
    color: #9aa2ad;

    font-size: 0.7rem;
  }

  /* ================================
     TABLET
  ================================= */

  @media (max-width: 850px) {
    .nav-wrap {
      width: min(calc(100% - 40px), var(--max));

      gap: 25px;
    }

    .site-header nav {
      gap: 20px;
    }
  }

  /* ================================
     MOBILE
  ================================= */

  @media (max-width: 650px) {
    .nav-wrap {
      width: min(calc(100% - 32px), var(--max));

      min-height: auto;

      padding: 16px 0;

      align-items: flex-start;
      flex-direction: column;

      gap: 13px;
    }

    .site-header nav {
      width: 100%;

      display: flex;
      flex-wrap: wrap;

      justify-content: flex-start;

      gap: 8px 19px;
    }

    .site-header nav a {
      font-size: 0.75rem;
    }

    .footer-wrap {
      width: min(calc(100% - 32px), var(--max));

      padding: 34px 0;

      flex-direction: column;

      gap: 25px;
    }

    .footer-right {
      align-items: flex-start;
    }

    .footer-links {
      flex-wrap: wrap;

      justify-content: flex-start;

      gap: 10px 18px;
    }
  }

  /* ================================
     SMALL MOBILE
  ================================= */

  @media (max-width: 420px) {
    .brand-name {
      font-size: 0.92rem;
    }

    .brand-role {
      font-size: 0.54rem;
    }

    .site-header nav {
      gap: 7px 15px;
    }
  }
</style>